{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evidencegate.local/auditors/problem-evidence/gate2a/schema/design-review-record.schema.json",
  "title": "Gate 2A-P Design Review Record",
  "description": "External review record and the sole authorizing instrument for a design-review transition. References an artifact and its canonical digest; never embedded in the artifact it reviews. A reviewer representation is a representation only: it is not authenticated identity and does not by itself authorize anything.",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "authorizationEvidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "evidenceKind": {
          "const": "private-approval-artifact-sha256"
        },
        "artifactSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "statement": {
          "const": "The repository owner approved the exact bound Gate 2A semantic-design package digest. Authorization evidence is the SHA-256 of a separately preserved private approval artifact."
        }
      },
      "required": [
        "evidenceKind",
        "artifactSha256",
        "statement"
      ]
    }
  },
  "properties": {
    "recordId": {
      "type": "string",
      "minLength": 1
    },
    "contractVersion": {
      "const": "0.15.0-draft"
    },
    "recordKind": {
      "const": "design-review"
    },
    "recordRole": {
      "enum": [
        "authoritative",
        "illustrative-example"
      ]
    },
    "reviewedArtifactPath": {
      "const": "auditors/problem-evidence/gate2a/manifest.json"
    },
    "reviewedArtifactVersion": {
      "type": "string",
      "minLength": 1
    },
    "reviewedArtifactDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "digestAlgorithm": {
      "const": "json.dumps-sort-keys-compact-sha256"
    },
    "reviewStatus": {
      "enum": [
        "pending-owner-review",
        "design-approved"
      ]
    },
    "humanReviewOccurred": {
      "type": "boolean"
    },
    "designApproved": {
      "type": "boolean"
    },
    "reviewerRepresentation": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "reviewTimestamp": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "scopeOfDecision": {
      "type": "string",
      "minLength": 1
    },
    "doesNotEstablish": {
      "const": [
        "Formal Phase 1 acceptance",
        "Gate 2C model-compatibility approval",
        "Bridge authority",
        "Classification authority",
        "Runtime enforcement",
        "Operational comparator use",
        "Production readiness"
      ]
    },
    "approvalScope": {
      "const": "gate2a-semantic-design"
    },
    "invariantsReviewed": {
      "const": [
        "X-8"
      ]
    },
    "deferredFindings": {
      "const": [
        "F-6",
        "F-7",
        "F-8",
        "F-9"
      ]
    },
    "authorizationEvidence": {
      "$ref": "#/$defs/authorizationEvidence"
    },
    "nonAuthorizations": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "grantsFormalPhase1Acceptance": {
          "const": false
        },
        "grantsGate2CModelCompatibility": {
          "const": false
        },
        "grantsBridgeAuthority": {
          "const": false
        },
        "grantsClassificationAuthority": {
          "const": false
        },
        "enablesRuntimeEnforcement": {
          "const": false
        },
        "permitsOperationalComparatorUse": {
          "const": false
        },
        "impliesProductionReadiness": {
          "const": false
        }
      },
      "required": [
        "grantsFormalPhase1Acceptance",
        "grantsGate2CModelCompatibility",
        "grantsBridgeAuthority",
        "grantsClassificationAuthority",
        "enablesRuntimeEnforcement",
        "permitsOperationalComparatorUse",
        "impliesProductionReadiness"
      ]
    }
  },
  "required": [
    "recordId",
    "contractVersion",
    "recordKind",
    "recordRole",
    "reviewedArtifactPath",
    "reviewedArtifactVersion",
    "reviewedArtifactDigest",
    "digestAlgorithm",
    "reviewStatus",
    "humanReviewOccurred",
    "designApproved",
    "reviewerRepresentation",
    "reviewTimestamp",
    "scopeOfDecision",
    "doesNotEstablish",
    "nonAuthorizations"
  ],
  "allOf": [
    {
      "if": {
        "required": [
          "reviewStatus"
        ],
        "properties": {
          "reviewStatus": {
            "const": "pending-owner-review"
          }
        }
      },
      "then": {
        "properties": {
          "humanReviewOccurred": {
            "const": false
          },
          "designApproved": {
            "const": false
          },
          "reviewerRepresentation": {
            "type": "null"
          },
          "reviewTimestamp": {
            "type": "null"
          },
          "scopeOfDecision": {
            "enum": [
              "No owner review has occurred. This record binds the candidate package digest under review and asserts no approval.",
              "Illustrative example of the external review-record shape. No review has occurred. The record references the package manifest and its digest and is excluded from that digest, so updating the record never mutates the reviewed content."
            ]
          },
          "approvalScope": false,
          "invariantsReviewed": false,
          "deferredFindings": false,
          "authorizationEvidence": false
        }
      }
    },
    {
      "if": {
        "required": [
          "reviewStatus"
        ],
        "properties": {
          "reviewStatus": {
            "const": "design-approved"
          }
        }
      },
      "then": {
        "required": [
          "approvalScope",
          "invariantsReviewed",
          "deferredFindings",
          "authorizationEvidence"
        ],
        "properties": {
          "recordRole": {
            "const": "authoritative"
          },
          "humanReviewOccurred": {
            "const": true
          },
          "designApproved": {
            "const": true
          },
          "reviewerRepresentation": {
            "const": "Repository owner — represented in this record; authorization evidenced separately by a private approval artifact SHA-256."
          },
          "reviewTimestamp": {
            "type": "string",
            "format": "date-time"
          },
          "scopeOfDecision": {
            "const": "Owner approval of the Gate 2A semantic design for the bound package digest. Invariant X-8 received owner review. Findings F-6 through F-9 remain deferred. This decision grants no authority beyond the approved semantic design."
          }
        }
      }
    }
  ]
}
