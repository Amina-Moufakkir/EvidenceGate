{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evidencegate.local/auditors/problem-evidence/gate2a/schema/outcome-taxonomy.schema.json",
  "title": "Gate 2A-P Outcome Taxonomy",
  "description": "Three disjoint result vocabularies. Only source_obligation rules may emit normative outcomes. Proxy and precondition results are never obligation compliance.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "packageId": {
      "const": "gate2a-p-outcome-taxonomy"
    },
    "contractVersion": {
      "const": "0.14.0-draft"
    },
    "resultClassByDerivation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source_obligation": {
          "const": "normative"
        },
        "evaluation_proxy": {
          "const": "proxy"
        },
        "evaluation_precondition": {
          "const": "precondition"
        },
        "note": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "source_obligation",
        "evaluation_proxy",
        "evaluation_precondition",
        "note"
      ]
    },
    "normativeOutcomes": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "outcome": {
            "enum": [
              "obligation_satisfied",
              "obligation_violation",
              "indeterminate",
              "evaluator_error",
              "not_applicable"
            ]
          },
          "definition": {
            "type": "string",
            "minLength": 1
          },
          "preconditions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "isPass": {
            "type": "boolean"
          },
          "isProductFinding": {
            "type": "boolean"
          },
          "countsAsObligationCompliance": {
            "type": "boolean"
          }
        },
        "required": [
          "outcome",
          "definition",
          "preconditions",
          "isPass",
          "isProductFinding",
          "countsAsObligationCompliance"
        ]
      }
    },
    "proxyResults": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "outcome": {
            "enum": [
              "condition_not_met",
              "evaluator_error",
              "indeterminate",
              "not_applicable",
              "obligation_satisfied",
              "obligation_violation",
              "precondition_available",
              "precondition_unavailable",
              "proxy_condition_met",
              "proxy_condition_not_met"
            ]
          },
          "definition": {
            "type": "string",
            "minLength": 1
          },
          "preconditions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "isPass": {
            "type": "boolean"
          },
          "isProductFinding": {
            "type": "boolean"
          },
          "countsAsObligationCompliance": {
            "type": "boolean"
          }
        },
        "required": [
          "outcome",
          "definition",
          "preconditions",
          "isPass",
          "isProductFinding",
          "countsAsObligationCompliance"
        ]
      }
    },
    "preconditionResults": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "outcome": {
            "enum": [
              "condition_not_met",
              "evaluator_error",
              "indeterminate",
              "not_applicable",
              "obligation_satisfied",
              "obligation_violation",
              "precondition_available",
              "precondition_unavailable",
              "proxy_condition_met",
              "proxy_condition_not_met"
            ]
          },
          "definition": {
            "type": "string",
            "minLength": 1
          },
          "preconditions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "isPass": {
            "type": "boolean"
          },
          "isProductFinding": {
            "type": "boolean"
          },
          "countsAsObligationCompliance": {
            "type": "boolean"
          }
        },
        "required": [
          "outcome",
          "definition",
          "preconditions",
          "isPass",
          "isProductFinding",
          "countsAsObligationCompliance"
        ]
      }
    },
    "notApplicableReachability": {
      "type": "string",
      "minLength": 1
    },
    "prohibitedConflations": {
      "type": "array",
      "minItems": 13,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "vacuousSatisfactionPolicy": {
      "type": "string",
      "minLength": 1
    },
    "diagnosticActivationResults": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "outcome": {
            "const": "condition_not_met"
          },
          "definition": {
            "type": "string",
            "minLength": 1
          },
          "preconditions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "isPass": {
            "type": "boolean"
          },
          "isProductFinding": {
            "type": "boolean"
          },
          "countsAsObligationCompliance": {
            "type": "boolean"
          }
        },
        "required": [
          "outcome",
          "definition",
          "preconditions",
          "isPass",
          "isProductFinding",
          "countsAsObligationCompliance"
        ]
      }
    }
  },
  "required": [
    "packageId",
    "contractVersion",
    "resultClassByDerivation",
    "normativeOutcomes",
    "proxyResults",
    "preconditionResults",
    "notApplicableReachability",
    "prohibitedConflations",
    "vacuousSatisfactionPolicy",
    "diagnosticActivationResults"
  ]
}
